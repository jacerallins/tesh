# AI runtime
TESH_AI_MODE=auto
TESH_AI_API_KEY=
TESH_AI_PROVIDER=openai-compatible
TESH_AI_MODEL=gpt-4o-mini
TESH_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
TESH_LOCAL_AI_MODEL=llama3.2:3b
TESH_LOCAL_AI_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
TESH_LOCAL_AI_TIMEOUT_MS=30000

# Native voice (set VITE_TESH_NATIVE_VOICE=true for the renderer)
VITE_TESH_NATIVE_VOICE=false
TESH_WAKEWORD_PYTHON=python
TESH_WAKEWORD_SCRIPT=tools/voice/openwakeword_bridge.py
TESH_WAKEWORD_MODEL=
TESH_SPEAKER_PYTHON=python
TESH_SPEAKER_SCRIPT=tools/voice/speaker_auth.py
TESH_SPEAKER_MODEL=
TESH_SPEAKER_PROFILE=

# Optional companion TLS server
TESH_COMPANION_TLS_CERT=
TESH_COMPANION_TLS_KEY=
TESH_COMPANION_BIND_HOST=127.0.0.1
TESH_COMPANION_PORT=0
